{
  "name": "workout",
  "version": "0.0.1",
  "description": "",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file .env dist/main.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --config ./jest.unit.config.ts",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --config ./jest.integration.config.ts --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --config ./jest.e2e.config.ts --runInBand",
    "lint": "prettier --check \"{src,tests}/**/*.{ts,json}\" && eslint \"{src,tests}/**/*.{ts,json}\"",
    "lint:fix": "prettier --check \"{src,tests}/**/*.{ts,json}\" --write && eslint \"{src,tests}/**/*.{ts,json}\" --fix"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "inversify": "^7.10.4",
    "mongodb": "^7.5.0",
    "uuid": "^14.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@golevelup/ts-jest": "3.0.0",
    "@testcontainers/mongodb": "^12.0.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "8.46.1",
    "@typescript-eslint/parser": "8.65.0",
    "cross-env": "^10.1.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.4",
    "jest": "^30.2.0",
    "jest-junit": "^17.0.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "3.9.6",
    "prettier-eslint": "16.3.0",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.4",
    "ts-jest": "^29.4.5",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2"
  }
}
